# Server settings. Copy this file to ".env" and adjust the values.
# On Vercel, add the same variables under Project Settings > Environment Variables instead.
# Overlay settings (TTS, volume, alert duration...) live in public/config.js.

# Shared secret your Roblox game sends with every donation. Requests without it are rejected.
CLIENT_SECRET="your_client_secret_here"

# Port for the local server (optional, defaults to 3000). Vercel ignores this.
PORT=3000

# How many unshown donations are kept while the overlay catches up (optional, defaults to 50). Older ones are dropped.
MAX_STORED_DONATIONS=50

# Maximum length of the donor name and message (optional, defaults to 200). Longer text is cut off.
MAX_TEXT_LENGTH=200
